# Backend base URL. Lokal: http://localhost:8123 ; prod: https://english.ihfazh.com
ENGLISH_API_BASE=http://localhost:8123

# DRF token akun layanan (guardian). Semua lesson dibuat atas nama akun ini.
# Ambil dari: backend $ manage.py drf_create_token <username>
ENGLISH_API_TOKEN=

# Inbound auth. DUA cara:
#  a) Secret-URL (dipakai untuk claude.ai): kosongkan MCP_BEARER_TOKEN dan
#     taruh secret di MCP_PATH, mis. /mcp/<hex-panjang>. URL itu = kredensial.
#     Generate: python -c "import secrets; print(secrets.token_hex(24))"
#  b) Header bearer (kalau claude.ai-mu punya kolom Request headers / untuk
#     klien lain): isi MCP_BEARER_TOKEN, klien kirim Authorization: Bearer <ini>.
MCP_BEARER_TOKEN=

# HTTP bind (dipakai saat run mode http)
MCP_HOST=127.0.0.1
MCP_PORT=8130
# Secret-URL: sisipkan token acak di sini, mis. /mcp/4686c9df...  (JANGAN commit)
MCP_PATH=/mcp
