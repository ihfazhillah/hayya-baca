# MeloTTS worker for user-created English lessons (Spec 064).
#
# Runs under the SEPARATE Python 3.12 venv (.venv-melo) — MeloTTS does not
# support the backend's Python 3.14. Shares the repo, Postgres and MEDIA_ROOT
# with hayyabaca.service via the same EnvironmentFile (.env).
#
# Install:
#   sudo cp deploy/english-tts.service /etc/systemd/system/english-tts.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now english-tts.service
[Unit]
Description=English Practice MeloTTS worker
After=network.target postgresql.service

[Service]
User=ihfazh
Group=ihfazh
WorkingDirectory=/home/ihfazh/hayyabaca/backend
EnvironmentFile=/home/ihfazh/hayyabaca/backend/.env
# NLTK (a MeloTTS dep) refuses to import `regex` while the CWD is on sys.path
# (CVE-2024-39705 shim). PYTHONSAFEPATH drops the CWD; PYTHONPATH re-adds the
# project dir explicitly so `config`/`english` still import.
Environment=PYTHONSAFEPATH=1
Environment=PYTHONPATH=/home/ihfazh/hayyabaca/backend
ExecStart=/home/ihfazh/hayyabaca/backend/.venv-melo/bin/python manage.py generate_pending_audio --loop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
