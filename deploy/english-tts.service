# English lesson audio worker (Spec 071).
#
# Runs under the MAIN backend venv (.venv, Python 3.14). Since Spec 071 the
# default TTS provider is Edge-TTS (free, light, EN-AU) — no MeloTTS/torch load,
# so the heavy .venv-melo is no longer needed here. Provider is chosen by
# ENGLISH_TTS_PROVIDER in the shared .env. Shares repo/Postgres/MEDIA_ROOT with
# hayyabaca.service via the same EnvironmentFile.
#
# Requires in .venv:  uv sync --group production --group tts   (edge-tts)
# Install:
#   sudo cp deploy/english-tts.service /etc/systemd/system/english-tts.service
#   sudo systemctl daemon-reload && sudo systemctl restart english-tts.service
[Unit]
Description=English Practice audio worker (Edge-TTS)
After=network.target postgresql.service

[Service]
User=ihfazh
Group=ihfazh
WorkingDirectory=/home/ihfazh/hayyabaca/backend
EnvironmentFile=/home/ihfazh/hayyabaca/backend/.env
ExecStart=/home/ihfazh/hayyabaca/backend/.venv/bin/python /home/ihfazh/hayyabaca/backend/manage.py generate_pending_audio --loop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
